# MongoDB (Atlas recommended — transactions require a replica set)
DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/nebtech_store?retryWrites=true&w=majority&appName=Cluster0"

# Auth — generate with: openssl rand -base64 48
AUTH_SECRET=

# App
NEXT_PUBLIC_APP_NAME="NebTech Store"
APP_URL="http://localhost:3000"

# Anthropic (AI inventory insights) — get a key at https://platform.claude.com
ANTHROPIC_API_KEY=

# M-Pesa via PayHero (https://payhero.co.ke)
PAYHERO_BASE_URL="https://backend.payhero.co.ke/api/v2"
PAYHERO_API_USERNAME=
PAYHERO_API_PASSWORD=
PAYHERO_CHANNEL_ID=
# Callback must be publicly reachable HTTPS (use ngrok/cloudflared for local dev)
PAYHERO_CALLBACK_URL="${APP_URL}/api/mpesa/callback"
