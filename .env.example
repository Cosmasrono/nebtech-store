# Copy this file to .env and fill in real values. Never put real secrets in this file:
# it is committed to git.

DATABASE_URL="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/nebtech_store?retryWrites=true&w=majority"
# 32+ random characters. Generate one with: openssl rand -base64 48
AUTH_SECRET=""

# App
NEXT_PUBLIC_APP_NAME="NebTech Store"
# Public address of the app. Used in emailed password links and the M-Pesa callback.
APP_URL="http://localhost:3000"

# Email (used for "set your password" invites and password resets).
# For Gmail, use an App Password: https://myaccount.google.com/apppasswords
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="NebTech Store"
# Comma-separated emails that always get full owner access
ADMIN_EMAILS=

# First owner account created by `pnpm db:seed` on an empty database (optional;
# if the password is left empty a random one is printed once).
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=

# AI inventory insights (Groq) — get a key at https://console.groq.com
GROQ_API_KEY=

# M-Pesa via PayHero (https://payhero.co.ke)
PAYHERO_BASE_URL="https://backend.payhero.co.ke/api/v2"
PAYHERO_API_USERNAME=
PAYHERO_API_PASSWORD=
PAYHERO_CHANNEL_ID=
# Callback must be publicly reachable HTTPS (use ngrok/cloudflared for local dev).
# Optional extra protection: set PAYHERO_CALLBACK_SECRET and add ?key=<same value> to the URL.
PAYHERO_CALLBACK_SECRET=
PAYHERO_CALLBACK_URL="${APP_URL}/api/mpesa/callback"
